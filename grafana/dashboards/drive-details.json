          "datasource": { "type": "influxdb", "uid": "TeslaMate" },
          "query": "SELECT mean(\"speed\")*1.60934*$length_unit AS \"Speed [${length_unit:text}/h]\", mean(\"power\") AS \"Power kW\", mean(\"battery_level\") AS \"Battery %\", mean(\"ideal_battery_range_km\")*$length_unit AS \"Ideal [${length_unit:text}]\" FROM \"positions\" WHERE time >= '$dstart' AND time <= '$dend' GROUP BY time(10s) fill(previous)",
